# Environment Variables — RSOCP
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL + TimescaleDB) ─────────────────────────────────────
DATABASE_URL="postgresql://rsocp_user:changeme@localhost:5432/rsocp_dev?schema=public"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRY=7d

# ── TOTP (MFA) ───────────────────────────────────────────────────────────────
TOTP_ISSUER=RSOCP

# ── Alerting ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rsocp.local

# ── RF Analytics microservice ────────────────────────────────────────────────
RF_ANALYTICS_URL=http://localhost:8000

# ── Go Worker ────────────────────────────────────────────────────────────────
GO_WORKER_POLL_INTERVAL_SEC=30
