{
  "name": "rsocp",
  "version": "0.1.0",
  "private": true,
  "description": "RF Spectrum Orchestration & Compliance Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/frontend --filter ./apps/backend dev",
    "build": "pnpm --filter ./apps/backend build && pnpm --filter ./apps/frontend build",
    "lint": "pnpm --filter ./apps/frontend lint && pnpm --filter ./apps/backend lint",
    "typecheck": "pnpm --filter ./apps/frontend typecheck && pnpm --filter ./apps/backend typecheck",
    "test": "pnpm --filter ./apps/backend test && pnpm --filter ./apps/frontend test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "printWidth": 100,
    "tabWidth": 2
  }
}
